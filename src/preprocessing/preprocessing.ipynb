   "source": [
    "# Each patent should have its own list of parent CPC codes.\n",
    "def extract_parent_cpc(cpc_list):\n",
    "    parent_codes = []\n",
    "\n",
    "    for code in cpc_list:\n",
    "        parent = code.split(\"/\")[0]\n",
    "\n",
    "        if len(parent) > 4:\n",
    "            parent = parent[:4]\n",
    "\n",
    "        parent_codes.append(parent)\n",
    "\n",
    "    # Remove duplicates while preserving order\n",
    "    return list(dict.fromkeys(parent_codes))\n",
    "\n",
    "df[\"parent_cpc\"] = df[\"cpc_codes\"].apply(extract_parent_cpc)"
   ]
