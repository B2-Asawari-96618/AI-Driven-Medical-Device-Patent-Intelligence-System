    "    # -------------------------------\n",
    "    if \"G16H\" in codes and len(codes & AI_CODES) > 0:\n",
    "        return \"AI-enabled Devices\"\n",
    "\n",
    "    # -------------------------------\n",
    "    # Rule 2: G16H + Diagnostic\n",
    "    # -------------------------------\n",
    "    if \"G16H\" in codes and len(codes & DIAGNOSTIC_CODES) > 0:\n",
    "        return \"Diagnostic Devices\"\n",
    "\n",
    "    # -------------------------------\n",
    "    # Rule 3: G16H + Remote Monitoring\n",
    "    # -------------------------------\n",
    "    if \"G16H\" in codes and len(codes & REMOTE_CODES) > 0:\n",
    "        return \"Remote Monitoring\"\n",
